# name: test/sql/optimizer/window_fusion_rank.test
# description: WindowFusion bounds rank() so the window drops rows before sorting them
# group: [optimizer]

statement ok
SET explain_output = 'physical_only';

statement ok
CREATE TABLE t AS
SELECT i, i % 7 AS p, (i * 37) % 101 AS v,
	CASE WHEN i % 11 = 0 THEN NULL ELSE (i * 37) % 101 END AS nv,
	((i * 13) % 5)::VARCHAR AS s,
	((i * 37) % 101)::DECIMAL(18,2) / 4 AS d
FROM range(10000) r(i);

statement ok
CREATE TABLE r AS SELECT p, i % 3 AS q, sum(v) AS s FROM t GROUP BY ROLLUP(p, q);

statement ok
CREATE TABLE ties AS SELECT i, CASE WHEN i < 5000 THEN 0 ELSE 1 END AS k FROM range(6000) r(i);

statement ok
CREATE TABLE ties2 AS SELECT i, i % 2 AS p, CASE WHEN i < 6000 THEN 0 ELSE i END AS k FROM range(10000) r(i);

statement ok
CREATE TABLE edge AS SELECT i, CASE WHEN i < 2048 THEN 0 ELSE 1 END AS k FROM range(4096) r(i);

statement ok
CREATE TABLE vx(p INTEGER, v INTEGER);

statement ok
INSERT INTO vx VALUES (1, 1), (1, 2), (1, 2), (1, 9), (1, 5), (2, 1), (2, 2), (2, 2), (2, 9), (2, 5);

statement ok
CREATE TABLE ord_asc AS SELECT i FROM range(5000) r(i) ORDER BY i;

statement ok
CREATE TABLE ord_desc AS SELECT i FROM range(5000) r(i) ORDER BY i DESC;

statement ok
CREATE TABLE ord_hash AS SELECT i FROM range(5000) r(i) ORDER BY hash(i);

statement ok
CREATE TABLE f(p DOUBLE, x DOUBLE);

statement ok
INSERT INTO f VALUES ('-0.0'::DOUBLE, 1), (0.0, 2), ('-0.0'::DOUBLE, 3), (0.0, 4), (1, 'NaN'), (1, 'inf'), (1, 'NaN'), (1, 5), (1, NULL), (2, '-0.0'::DOUBLE), (2, 0.0), (2, -1), (2, 'NaN');

# The bound is recorded for <= N, < N and = 1
query II
EXPLAIN SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v DESC) rk FROM t) WHERE rk <= 3;
----
physical_plan	<REGEX>:.*Rank Limit: 3\b.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v DESC) rk FROM t) WHERE rk < 20;
----
physical_plan	<REGEX>:.*Rank Limit: 19\b.*

query II
EXPLAIN SELECT p, v FROM t QUALIFY rank() OVER (PARTITION BY p ORDER BY v) = 1;
----
physical_plan	<REGEX>:.*Rank Limit: 1\b.*

query II
EXPLAIN SELECT * FROM (SELECT v, rank() OVER (ORDER BY v) rk FROM t) WHERE rk <= 1000;
----
physical_plan	<REGEX>:.*Rank Limit: 1000\b.*

query II
EXPLAIN SELECT * FROM (SELECT v, rank() OVER (ORDER BY v) rk FROM t) WHERE rk < 1001;
----
physical_plan	<REGEX>:.*Rank Limit: 1000\b.*

query II
EXPLAIN SELECT * FROM (SELECT p, s, v, rank() OVER (PARTITION BY p ORDER BY s DESC, v ASC) rk FROM t) WHERE rk <= 4;
----
physical_plan	<REGEX>:.*Rank Limit: 4\b.*

# Shapes that are not bounded
query II
EXPLAIN SELECT * FROM (SELECT v, rank() OVER (ORDER BY v) rk FROM t) WHERE rk <= 1001;
----
physical_plan	<!REGEX>:.*Rank Limit.*

query II
EXPLAIN SELECT * FROM (SELECT v, rank() OVER (ORDER BY v) rk FROM t) WHERE rk <= 0;
----
physical_plan	<!REGEX>:.*Rank Limit.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, dense_rank() OVER (PARTITION BY p ORDER BY v) rk FROM t) WHERE rk <= 3;
----
physical_plan	<!REGEX>:.*Rank Limit.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p) rk FROM t) WHERE rk <= 3;
----
physical_plan	<!REGEX>:.*Rank Limit.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v) rk FROM t) WHERE rk = 2;
----
physical_plan	<!REGEX>:.*Rank Limit.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v) rk FROM t) WHERE rk > 1;
----
physical_plan	<!REGEX>:.*Rank Limit.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v) rk FROM t) WHERE rk > 1 AND rk <= 3;
----
physical_plan	<!REGEX>:.*Rank Limit.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p % 3 ORDER BY v) rk FROM t) WHERE rk <= 3;
----
physical_plan	<!REGEX>:.*Rank Limit.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v) rk, sum(v) OVER (PARTITION BY p ORDER BY v) sv FROM t) WHERE rk <= 3;
----
physical_plan	<!REGEX>:.*Rank Limit.*

# row_number() keeps its existing aggregate rewrite
query II
EXPLAIN SELECT * FROM (SELECT p, v, row_number() OVER (PARTITION BY p ORDER BY v) rn FROM t) WHERE rn <= 3;
----
physical_plan	<REGEX>:.*arg_min_nulls_last.*

query II
EXPLAIN SELECT * FROM (SELECT p, v, row_number() OVER (PARTITION BY p ORDER BY v) rn FROM t) WHERE rn <= 3;
----
physical_plan	<!REGEX>:.*Rank Limit.*

# Results: ties at the bound, DESC / ASC, NULL order keys, multiple partitions
query IIII
SELECT p, count(*), sum(v), sum(rk) FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v DESC) rk FROM t) WHERE rk <= 3 GROUP BY p ORDER BY p;
----
0	14	1400	14
1	14	1400	14
2	15	1500	15
3	14	1400	14
4	14	1400	14
5	14	1400	14
6	14	1400	14

query IIII
SELECT p, count(*), sum(v), sum(rk) FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v DESC) rk FROM t) WHERE rk < 20 GROUP BY p ORDER BY p;
----
0	28	2786	224
1	28	2786	224
2	29	2886	239
3	28	2786	224
4	29	2885	239
5	28	2786	224
6	28	2786	224

query IIII
SELECT p, count(*), min(v), max(v) FROM (SELECT p, v FROM t QUALIFY rank() OVER (PARTITION BY p ORDER BY v) = 1) GROUP BY p ORDER BY p;
----
0	15	0	0
1	14	0	0
2	14	0	0
3	15	0	0
4	14	0	0
5	14	0	0
6	14	0	0

query IIII
SELECT p, count(*), count(nv), sum(rk) FROM (SELECT p, nv, rank() OVER (PARTITION BY p ORDER BY nv ASC NULLS FIRST) rk FROM t) WHERE rk <= 150 GROUP BY p ORDER BY p;
----
0	156	26	3705
1	156	26	3705
2	156	26	3705
3	155	25	3561
4	156	26	3705
5	155	25	3561
6	156	26	3705

query IIIII
SELECT p, count(*), count(nv), sum(nv), sum(rk) FROM (SELECT p, nv, rank() OVER (PARTITION BY p ORDER BY nv DESC NULLS LAST) rk FROM t) WHERE rk <= 30 GROUP BY p ORDER BY p;
----
0	38	38	3761	519
1	38	38	3763	519
2	39	39	3861	546
3	39	39	3861	546
4	39	39	3861	546
5	39	39	3861	546
6	38	38	3762	519

query III
SELECT count(*), sum(v), sum(rk) FROM (SELECT v, rank() OVER (ORDER BY v DESC) rk FROM t) WHERE rk <= 20;
----
99	9900	99

# The NULL partition produced by ROLLUP is its own partition
query IIII
SELECT p, q, s, rk FROM (SELECT p, q, s, rank() OVER (PARTITION BY p ORDER BY s DESC) rk FROM r) WHERE rk <= 2 ORDER BY p NULLS FIRST, rk, q NULLS FIRST;
----
NULL	NULL	499950	1
0	NULL	71433	1
0	1	23848	2
1	NULL	71382	1
1	0	23849	2
2	NULL	71533	1
2	2	23924	2
3	NULL	71381	1
3	0	23898	2
4	NULL	71394	1
4	1	23835	2
5	NULL	71407	1
5	0	23836	2
6	NULL	71420	1
6	2	23837	2

# Ties that span several vectors, in one partition and in two partitions at rank 1
query III
SELECT count(*), sum(rk), max(k) FROM (SELECT k, rank() OVER (ORDER BY k) rk FROM ties) WHERE rk <= 1;
----
5000	5000	0

query III
SELECT p, count(*), sum(rk) FROM (SELECT p, k, rank() OVER (PARTITION BY p ORDER BY k) rk FROM ties2) WHERE rk <= 1 GROUP BY p ORDER BY p;
----
0	3000	3000
1	3000	3000

# The ties at the bound fill exactly one vector and the next vector ranks behind them
query II
SELECT count(*), max(k) FROM (SELECT k, rank() OVER (ORDER BY k) rk FROM edge) WHERE rk <= 1;
----
2048	0

query III
SELECT count(*), max(k), max(rk) FROM (SELECT k, rank() OVER (ORDER BY k) rk FROM edge) WHERE rk <= 2;
----
2048	0	1

# A row arriving after tied rows that it ranks behind
query III
SELECT p, v, rk FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v) rk FROM vx) WHERE rk <= 3 ORDER BY p, v;
----
1	1	1
1	2	2
1	2	2
2	1	1
2	2	2
2	2	2

query III
SELECT p, v, rk FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v) rk FROM vx) WHERE rk <= 4 ORDER BY p, v;
----
1	1	1
1	2	2
1	2	2
1	5	4
2	1	1
2	2	2
2	2	2
2	5	4

# Arrival order does not change the result
query III
SELECT count(*), sum(i), sum(rk) FROM (SELECT i, rank() OVER (ORDER BY i % 97) rk FROM ord_asc) WHERE rk <= 60;
----
104	257296	2808

query III
SELECT count(*), sum(i), sum(rk) FROM (SELECT i, rank() OVER (ORDER BY i % 97) rk FROM ord_desc) WHERE rk <= 60;
----
104	257296	2808

query III
SELECT count(*), sum(i), sum(rk) FROM (SELECT i, rank() OVER (ORDER BY i % 97) rk FROM ord_hash) WHERE rk <= 60;
----
104	257296	2808

# NaN, infinity, NULL and -0.0 / 0.0 in the order key; -0.0 and 0.0 are one partition
query TTI
SELECT p::VARCHAR, x::VARCHAR, rk FROM (SELECT p, x, rank() OVER (PARTITION BY p ORDER BY x DESC NULLS LAST) rk FROM f) WHERE rk <= 2 ORDER BY ALL;
----
-0.0	3.0	2
0.0	4.0	1
1.0	nan	1
1.0	nan	1
2.0	-0.0	2
2.0	0.0	2
2.0	nan	1

query TTI
SELECT p::VARCHAR, x::VARCHAR, rk FROM (SELECT p, x, rank() OVER (PARTITION BY p ORDER BY x ASC NULLS FIRST) rk FROM f) WHERE rk <= 2 ORDER BY ALL;
----
-0.0	1.0	1
0.0	2.0	2
1.0	5.0	2
1.0	NULL	1
2.0	-0.0	2
2.0	-1.0	1
2.0	0.0	2

# VARCHAR and multi-column order keys, DECIMAL order keys
query IIII
SELECT p, count(*), sum(v), sum(rk) FROM (SELECT p, s, v, rank() OVER (PARTITION BY p ORDER BY s DESC, v ASC) rk FROM t) WHERE rk <= 4 GROUP BY p ORDER BY p;
----
0	6	3	15
1	5	3	11
2	6	3	15
3	6	3	15
4	6	3	15
5	6	3	15
6	5	2	11

query IRII
SELECT p, count(*), sum(d), sum(rk) FROM (SELECT p, d, rank() OVER (PARTITION BY p ORDER BY d DESC) rk FROM t) WHERE rk <= 5 GROUP BY p ORDER BY p;
----
0	14	350.00	14
1	14	350.00	14
2	15	375.00	15
3	14	350.00	14
4	14	350.00	14
5	14	350.00	14
6	14	350.00	14

query I
SELECT count(*) FROM (SELECT v, rank() OVER (ORDER BY v) rk FROM t) WHERE rk <= 0;
----
0

# Inputs that stop the prefilter: every row beats the current bound, and more partitions than the memory budget holds
query II
SELECT count(*), sum(rk) FROM (SELECT rank() OVER (ORDER BY i DESC) rk FROM range(2000000) r(i)) WHERE rk <= 1000;
----
1000	500500

query II
SELECT count(*), sum(rk) FROM (SELECT rank() OVER (PARTITION BY i % 1000000 ORDER BY i) rk FROM range(3000000) r(i)) WHERE rk <= 1000;
----
3000000	6000000

# Rows dropped before the sort: with one thread the input arrives in order, so the counts are exact
statement ok
SET threads=1;

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT * FROM (SELECT i, rank() OVER (ORDER BY i) rk FROM range(10000) t(i)) WHERE rk <= 10;
----
analyzed_plan	<REGEX>:.*"intermediate_rows": 10,\s*"intermediate_size_bytes": \d+,\s*"name": "WINDOW".*

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT * FROM (SELECT k, rank() OVER (ORDER BY k) rk FROM ties) WHERE rk <= 1;
----
analyzed_plan	<REGEX>:.*"intermediate_rows": 5000,\s*"intermediate_size_bytes": \d+,\s*"name": "WINDOW".*

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT * FROM (SELECT k, rank() OVER (ORDER BY k) rk FROM edge) WHERE rk <= 2;
----
analyzed_plan	<REGEX>:.*"intermediate_rows": 2048,\s*"intermediate_size_bytes": \d+,\s*"name": "WINDOW".*

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT * FROM (SELECT p, v, rank() OVER (PARTITION BY p ORDER BY v) rk FROM vx) WHERE rk <= 3;
----
analyzed_plan	<REGEX>:.*"intermediate_rows": 6,\s*"intermediate_size_bytes": \d+,\s*"name": "WINDOW".*

statement ok
SET disabled_optimizers = 'window_fusion';

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT * FROM (SELECT i, rank() OVER (ORDER BY i) rk FROM range(10000) t(i)) WHERE rk <= 10;
----
analyzed_plan	<REGEX>:.*"intermediate_rows": 10000,\s*"intermediate_size_bytes": \d+,\s*"name": "WINDOW".*

query II
EXPLAIN SELECT * FROM (SELECT i, rank() OVER (ORDER BY i) rk FROM range(10000) t(i)) WHERE rk <= 10;
----
physical_plan	<!REGEX>:.*Rank Limit.*

statement ok
RESET disabled_optimizers;

statement ok
RESET threads;
